---
import { alternatePath } from '../i18n/paths';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const target: Lang = lang === 'en' ? 'pt' : 'en';
const href = alternates[target] ?? alternatePath(Astro.url.pathname, target);
---

<a class="lang-switch" href={href} hreflang={target === 'en' ? 'en-US' : 'pt-BR'} aria-label={t(lang, 'lang.switchLabel')}>
  {t(lang, 'lang.switch')}
</a>

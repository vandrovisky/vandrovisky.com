---
import { Image } from 'astro:assets';
import { ROUTES } from '../i18n/paths';
import { caseSlug, type Case } from '../i18n/content';

interface Props { entry: Case }
const { entry } = Astro.props;
const { title, summary, stack, year, kind, cover, lang } = entry.data;
const href = `${ROUTES.work[lang]}${caseSlug(entry)}/`;
---

<article class="case-card" data-case data-kind={kind} data-reveal>
  <a href={href} class="case-card__link">
    {cover ? (
      <Image src={cover} alt="" class="case-card__cover" widths={[480, 960]} sizes="(min-width: 800px) 33vw, 100vw" />
    ) : (
      <div class="case-card__cover case-card__cover--type" aria-hidden="true">{title}</div>
    )}
    <h3 class="case-card__title">{title}</h3>
  </a>
  <p class="case-card__summary">{summary}</p>
  <p class="case-card__meta">{year}{stack.length > 0 && ` · ${stack.slice(0, 3).join(' · ')}`}</p>
</article>

<style>
  .case-card { display: grid; gap: var(--space-2); min-width: 0; }
  .case-card__link { text-decoration: none; display: grid; gap: var(--space-3); min-width: 0; }
  .case-card__cover {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--color-line);
  }
  .case-card__cover--type {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
    padding: var(--space-4);
    text-align: center;
    overflow-wrap: anywhere;
  }
  .case-card__title { font-size: 1.35rem; }
  .case-card__link:hover .case-card__title { text-decoration: underline; text-underline-offset: 4px; }
  .case-card__summary { color: var(--color-muted); }
  .case-card__meta { font-family: var(--font-mono); font-size: .8rem; color: var(--color-muted); }
</style>

---
import HoloCard from './HoloCard.astro';
import cards from '../data/cards.json';
import type { Card } from '../../scripts/cards/types';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const pool = (cards as Card[]).filter((c) => c.image);
// Static fallback for no-JS visitors: one of each game first, then the rest.
const games = [...new Set(pool.map((c) => c.game))];
const first = games.map((g) => pool.find((c) => c.game === g)!);
const initial = [...first, ...pool.filter((c) => !first.includes(c))].slice(0, 6);
const slim = pool.map(({ id, game, name, set, image }) => ({ id, game, name, set, image }));
const title = lang === 'en' ? 'Card table' : 'Mesa de cartas';
const hint = lang === 'en' ? 'A new hand every visit. Hover or touch a card.' : 'Uma mão nova a cada visita. Passe o mouse ou toque numa carta.';
---

<section class="card-table" data-reveal>
  <h2>{title}</h2>
  <p class="card-table__hint">{hint}</p>
  <div class="card-table__grid" data-card-table>
    {initial.map((card) => <HoloCard card={card} />)}
  </div>
  <script type="application/json" data-card-pool set:html={JSON.stringify(slim)} />
  <p class="card-table__disclaimer">{t(lang, 'cards.disclaimer')}</p>
</section>

<script>
  import { initHolo } from '../scripts/holo';
  import { sampleCards } from '../scripts/sample';

  type Slim = { id: string; game: 'pokemon' | 'magic' | 'onepiece'; name: string; set: string; image: string };

  const table = document.querySelector<HTMLElement>('[data-card-table]');
  const raw = document.querySelector('[data-card-pool]')?.textContent;
  if (table && raw) {
    const slots = [...table.querySelectorAll<HTMLElement>('.holo')];
    const hand = sampleCards(JSON.parse(raw) as Slim[], slots.length);
    hand.forEach((card, i) => {
      const img = slots[i].querySelector('img')!;
      img.src = card.image;
      img.alt = `${card.name} — ${card.set}`;
      slots[i].dataset.game = card.game;
    });
    slots.forEach((s) => initHolo(s));
  }
</script>

<style>
  .card-table { display: grid; gap: var(--space-4); }
  .card-table__hint, .card-table__disclaimer { color: var(--color-muted); }
  .card-table__disclaimer { font-size: .8rem; }
  .card-table__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 560px) { .card-table__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .card-table__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>

---
import { SECTIONS } from '../i18n/paths';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const stack = {
  Backend: ['PHP', 'Laravel', 'Livewire', 'Python', 'FastAPI', 'Django', 'Node.js'],
  Frontend: ['JavaScript', 'TypeScript', 'Vue.js', 'React'],
  Data: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'],
  DevOps: ['Docker', 'Docker Swarm', 'AWS (EC2, RDS, S3)', 'CI/CD', 'Nginx', 'Linux'],
  Messaging: ['RabbitMQ', 'Kafka', 'Chatwoot'],
};

const copy = {
  en: {
    h1: 'About',
    intro: 'Full-stack developer with a strong backend focus (Laravel and Python), Docker and AWS. I started in IT support, grew into development at JMV Technology and today lead a PHP-to-Laravel migration at Prontomed.',
    career: 'Career',
    jobs: [
      { when: 'Aug 2026 — now', what: 'Full-stack Developer', where: 'Prontomed Planos de Saúde' },
      { when: 'Dec 2025 — Jul 2026', what: 'Full-stack Developer (Mid-level)', where: 'JMV Technology' },
      { when: 'Feb 2023 — Dec 2025', what: 'Full-stack Developer (Junior)', where: 'JMV Technology' },
      { when: 'Feb 2020 — Feb 2023', what: 'IT Support Specialist', where: 'JMV Technology' },
    ],
    stack: 'Stack',
    edu: 'Education',
    eduText: 'B.Sc. in Computer Engineering — UEMG, Divinópolis (2018–2025)',
    langs: 'Languages',
    langsText: 'Portuguese (native) · English (upper-intermediate, B2)',
    certs: 'Certifications',
    certsId: 'certifications',
  },
  pt: {
    h1: 'Sobre',
    intro: 'Desenvolvedor fullstack com forte foco em backend (Laravel e Python), Docker e AWS. Comecei no suporte de TI, cresci para o desenvolvimento na JMV Technology e hoje conduzo uma migração de PHP puro para Laravel na Prontomed.',
    career: 'Trajetória',
    jobs: [
      { when: 'Ago 2026 — hoje', what: 'Desenvolvedor Fullstack', where: 'Prontomed Planos de Saúde' },
      { when: 'Dez 2025 — Jul 2026', what: 'Desenvolvedor Fullstack Pleno', where: 'JMV Technology' },
      { when: 'Fev 2023 — Dez 2025', what: 'Desenvolvedor Fullstack Júnior', where: 'JMV Technology' },
      { when: 'Fev 2020 — Fev 2023', what: 'Especialista em Suporte de TI', where: 'JMV Technology' },
    ],
    stack: 'Stack',
    edu: 'Formação',
    eduText: 'Bacharelado em Engenharia da Computação — UEMG, Divinópolis (2018–2025)',
    langs: 'Idiomas',
    langsText: 'Português (nativo) · Inglês (intermediário avançado, B2)',
    certs: 'Certificações',
    certsId: 'certificacoes',
  },
}[lang];

// TODO(conteúdo): confirm the full certification list with Eric.
const certs = [
  { name: 'Claude Code 101, Claude 101, Claude Code in Action', by: 'Anthropic' },
  { name: lang === 'en' ? 'WhatsApp support bot with Python and PHP' : 'BOT de Atendimento WhatsApp com Python e PHP', by: 'Udemy · 2024' },
];
---

<section id={SECTIONS.about[lang]} data-alt={SECTIONS.about[lang === 'en' ? 'pt' : 'en']} class="about section" aria-labelledby="about-title">
  <h2 id="about-title" class="section__title" data-cursor-anchor data-reveal="words">{copy.h1}</h2>
  <p class="about__intro" data-reveal>{copy.intro}</p>

  <div class="about__block" data-reveal>
    <h3>{copy.career}</h3>
    <ol class="timeline">
      {copy.jobs.map((j) => (
        <li><span class="timeline__when">{j.when}</span><strong>{j.what}</strong><span>{j.where}</span></li>
      ))}
    </ol>
  </div>

  <div class="about__block" data-reveal>
    <h3>{copy.stack}</h3>
    <dl class="stack">
      {Object.entries(stack).map(([group, items]) => (
        <div><dt>{group}</dt><dd>{items.join(' · ')}</dd></div>
      ))}
    </dl>
  </div>

  <div class="about__block" data-reveal>
    <h3>{copy.edu}</h3>
    <p>{copy.eduText}</p>
  </div>

  <div class="about__block" data-reveal>
    <h3>{copy.langs}</h3>
    <p>{copy.langsText}</p>
  </div>

  <div id={copy.certsId} class="about__block" data-reveal>
    <h3>{copy.certs}</h3>
    <ul class="certs">
      {certs.map((c) => <li>{c.name} <span>— {c.by}</span></li>)}
    </ul>
  </div>
</section>

<style>
  .about { max-width: 900px; }
  .about h3 { font-size: 1.25rem; margin-bottom: var(--space-3); }
  .about__intro { font-size: 1.25rem; max-width: var(--measure); }
  .timeline { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .timeline li { display: grid; grid-template-columns: 12rem 1fr; gap: 0 var(--space-4); }
  .timeline li > span:last-child { grid-column: 2; color: var(--color-muted); }
  .timeline__when { font-family: var(--font-mono); font-size: .85rem; color: var(--color-muted); grid-row: span 2; }
  .stack { display: grid; gap: var(--space-2); }
  .stack div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--space-4); }
  .stack dt { font-family: var(--font-mono); font-size: .85rem; color: var(--color-muted); }
  .certs { padding-left: 1.1em; }
  .certs span { color: var(--color-muted); }
  @media (max-width: 600px) {
    .timeline li, .stack div { grid-template-columns: 1fr; }
    .timeline li > span:last-child { grid-column: 1; }
  }
</style>

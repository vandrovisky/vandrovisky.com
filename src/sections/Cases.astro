---
import CaseRow from '../components/CaseRow.astro';
import { getCases } from '../i18n/content';
import { SECTIONS } from '../i18n/paths';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cases = await getCases(lang);
const copy = {
  en: { title: 'Cases', lead: 'Problems I solved in production, told from the inside: context, architecture, decisions and results.' },
  pt: { title: 'Cases', lead: 'Problemas que resolvi em produção, contados por dentro: contexto, arquitetura, decisões e resultado.' },
}[lang];
---

<section data-mood="alt" id={SECTIONS.cases[lang]} data-alt={SECTIONS.cases[lang === 'en' ? 'pt' : 'en']} class="section" aria-labelledby="cases-title">
  <h2 id="cases-title" class="section__title" data-cursor-anchor data-reveal="words">{copy.title}</h2>
  <p class="section__lead" data-reveal>{copy.lead}</p>
  <ol class="case-list">
    {cases.map((entry, i) => <CaseRow entry={entry} index={i} />)}
  </ol>
</section>

<style>
  .case-list { list-style: none; padding: 0; border-top: 1px solid var(--color-line); }
</style>

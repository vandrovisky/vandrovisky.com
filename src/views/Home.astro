---
import Base from '../layouts/Base.astro';
import About from '../sections/About.astro';
import Cases from '../sections/Cases.astro';
import Hobbies from '../sections/Hobbies.astro';
import Contact from '../sections/Contact.astro';
import { sectionHref } from '../i18n/paths';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  en: {
    title: 'Eric Robertson — Full-stack Developer',
    desc: 'Full-stack developer focused on backend (Laravel, Python) and DevOps. About, cases, hobbies and contact.',
    hello: 'Full-stack developer',
    lead: 'I build backends that hold up — Laravel, Python, Docker, queues — and the interfaces on top of them.',
    cta: 'See the cases',
    contact: 'Get in touch',
  },
  pt: {
    title: 'Eric Robertson — Desenvolvedor Fullstack',
    desc: 'Desenvolvedor fullstack com foco em backend (Laravel, Python) e DevOps. Sobre, cases, hobbies e contato.',
    hello: 'Desenvolvedor fullstack',
    lead: 'Construo backends que aguentam o tranco — Laravel, Python, Docker, filas — e as interfaces em cima deles.',
    cta: 'Ver os cases',
    contact: 'Fale comigo',
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.desc} alternates={{ en: '/', pt: '/pt/' }}>
  <header class="hero" data-cursor-anchor>
    <p class="hero__kicker">{copy.hello}</p>
    <h1 data-reveal="words">Eric Robertson</h1>
    <p class="hero__lead" data-reveal>{copy.lead}</p>
    <p class="hero__actions" data-reveal>
      <a class="hero__cta" href={sectionHref('cases', lang)}>{copy.cta}</a>
      <a href={sectionHref('contact', lang)}>{copy.contact}</a>
    </p>
  </header>

  <About lang={lang} />
  <Cases lang={lang} />
  <Hobbies lang={lang} />
  <Contact lang={lang} />
</Base>

<style>
  .hero { min-height: 80vh; display: grid; align-content: center; gap: var(--space-4); }
  .hero h1 { font-size: clamp(3rem, 12vw, 9rem); }
  .hero__kicker { font-family: var(--font-mono); color: var(--color-accent-text); }
  .hero__lead { font-size: clamp(1.15rem, 2.4vw, 1.5rem); max-width: 40ch; }
  .hero__actions { display: flex; gap: var(--space-5); flex-wrap: wrap; }
  .hero__cta { font-weight: 600; }
</style>

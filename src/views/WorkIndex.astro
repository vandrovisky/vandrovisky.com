---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCases } from '../i18n/content';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cases = await getCases(lang);
const copy = {
  en: { title: 'Work — Eric Robertson', h1: 'Work', desc: 'Selected projects and technical case studies by Eric Robertson.' },
  pt: { title: 'Trabalho — Eric Robertson', h1: 'Trabalho', desc: 'Projetos e cases técnicos selecionados de Eric Robertson.' },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.desc}>
  <h1 data-cursor-anchor class="page-title" data-reveal="words">{copy.h1}</h1>
  <div class="case-grid">
    {cases.map((entry) => <CaseCard entry={entry} />)}
  </div>
</Base>

<style>
  .case-grid {
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
</style>

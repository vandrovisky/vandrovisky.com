---
import type { GetStaticPaths } from 'astro';
import CasePage from '../../views/CasePage.astro';
import { caseSlug, getCases, type Case } from '../../i18n/content';

export const getStaticPaths = (async () => {
  const cases = await getCases('en');
  return cases.map((entry) => ({ params: { slug: caseSlug(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props { entry: Case }
const { entry } = Astro.props;
---

<CasePage entry={entry} />

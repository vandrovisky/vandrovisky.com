{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vandrovisky",
  "compatibility_date": "2026-11-01",
  // Static site only: no Worker script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom domain (vandrovisky.com) is attached only at launch (Plan 2).
  "workers_dev": true,
  "preview_urls": true
}
